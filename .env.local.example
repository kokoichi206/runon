# Strava 連携を有効化する場合だけ設定（任意）。
# https://www.strava.com/settings/api でアプリを作成し、
# Authorization Callback Domain = localhost に設定して取得。
# これらを設定したら dev サーバを再起動 → /training の「Strava と連携」が有効化されます。
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 任意: リダイレクト基底 URL（未設定ならリクエストの origin を使用。通常は不要）
# STRAVA_REDIRECT_BASE=http://localhost:3077

# 任意: 自前 Overpass エンドポイント / User-Agent（未設定なら公開エンドポイントを使用）
# OVERPASS_ENDPOINT=
# OVERPASS_USER_AGENT=

# 任意: OG 画像など絶対 URL の解決に使う公開 URL（未設定なら http://localhost:3077）
# SITE_URL=https://example.com
