{
  "name": "runon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.12.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev -p 3077",
    "build": "next build",
    "start": "next start -p 3077",
    "type-check": "tsc --noEmit --pretty false",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:eslint-rules": "node eslint-rules/no-single-line-block-comment/test.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "rt:smoke": "tsx scripts/smoke-round-trip.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "next": "16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "8.60.1",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.0",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.8"
  }
}
